{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smriti",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // P0-2：wrangler 侧的 Node 兼容 flag（jose / MCP SDK 依赖 node 内置能力）。
  "compatibility_flags": ["nodejs_compat"],
  // WebUI 静态资源：Worker 优先处理请求（run_worker_first），/ui 由 handle 鉴权后
  // 再交给 env.ASSETS；未匹配到资源时交回 Worker（not_found_handling: none）。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "MEMORY",
      "bucket_name": "smriti-memory"
    }
  ],
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      // Smriti 的索引实例：namespace `work` 下的 `memory`。
      "namespace": "work",
      "remote": true
    }
  ],
  "vars": {
    "ACCESS_AUD": "00883228bd3d93c494f3588fb10f6fd79b144fd1459853fff7933b2dff596c3c",
    "ACCESS_TEAM_DOMAIN": "ymslucky.cloudflareaccess.com",
    "AI_SEARCH_INSTANCE": "memory",
    "AUTH_MODE": "access",
    "SYNC_INTERVAL_SECONDS": "900",
    // 冲突策略：caller（默认，调用方模型裁决）/ server（服务端直接覆盖）/ manual（人工）。
    "CONFLICT_POLICY": "caller",
    // 常驻（core）记忆：这些前缀下的记录每次召回都会优先带上。
    "CORE_TOPIC_PREFIXES": "identity",
    "CORE_RECALL_LIMIT": "5"
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
